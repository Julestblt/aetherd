# aetherd environment configuration.
#
# A configuration file is optional: these variables plus built-in defaults are
# sufficient. Nested keys use a double underscore separator.

# HTTP bind address. Use 0.0.0.0:8080 inside a container.
AETHERD_HTTP__BIND=127.0.0.1:8080

# Configurable host filesystem roots. Point these at read-only host mounts when
# running in Docker.
AETHERD_PATHS__PROC=/proc
AETHERD_PATHS__SYS=/sys
AETHERD_PATHS__HOST_ROOT=/

# Log verbosity for the daemon.
RUST_LOG=info
