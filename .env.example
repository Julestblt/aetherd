# aetherd environment configuration.
#
# A configuration file is optional: these variables plus built-in defaults are
# sufficient. Nested keys use a double underscore separator.

# HTTP bind address. Use 0.0.0.0:8080 inside a container.
AETHERD_HTTP__BIND=127.0.0.1:8080

# Configurable host filesystem roots. Point these at read-only host mounts when
# running in Docker.
AETHERD_PATHS__PROC=/proc
AETHERD_PATHS__SYS=/sys
AETHERD_PATHS__HOST_ROOT=/

# Background sampling interval in milliseconds (100..=3600000).
AETHERD_SAMPLING__INTERVAL_MS=1000

# Optional Tailscale tailnet telemetry. Uses the official HTTP API; no tailscale
# CLI or host socket is required. Leave disabled (or without a tailnet/API key)
# and the daemon still starts with the rest of the metrics.
# AETHERD_TAILSCALE__ENABLED=true
# AETHERD_TAILSCALE__TAILNET=example.ts.net
# AETHERD_TAILSCALE__API_KEY=
# AETHERD_TAILSCALE__REFRESH_INTERVAL_SECONDS=60

# Log verbosity for the daemon.
RUST_LOG=info

AETHERD_PROVIDERS__CODEX__ENABLED=false
AETHERD_PROVIDERS__CODEX__AUTH_FILE=/run/secrets/codex-auth.json
AETHERD_PROVIDERS__CODEX__REFRESH_INTERVAL_SECONDS=60
AETHERD_PROVIDERS__OPENCODE__ENABLED=false
AETHERD_PROVIDERS__OPENCODE__API_KEY=
AETHERD_PROVIDERS__OPENCODE__REFRESH_INTERVAL_SECONDS=60
